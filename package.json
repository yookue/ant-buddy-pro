{
    "name": "@yookue/ant-buddy-pro",
    "version": "1.0.19",
    "title": "Ant Buddy Pro",
    "description": "Awesome components based on Ant Design & Ant ProComponents",
    "homepage": "https://yookue.github.io/ant-buddy-pro",
    "organization": "Yookue Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "ant-buddy",
        "ant-buddy-pro",
        "antd",
        "ant-design",
        "ant-design-pro",
        "ant-pro-components",
        "admin",
        "dashboard"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": [
        "**/*.less"
    ],
    "scripts": {
        "start": "npm run start:dev",
        "start:dev": "cross-env APP_ENV=dev dumi dev",
        "start:prd": "cross-env APP_ENV=prd dumi dev",
        "build": "del-cli ./dist && father build",
        "doctor": "father doctor",
        "docs:build": "npm run docs:build-prd",
        "docs:build-dev": "del-cli ./docs-dist && cross-env APP_ENV=dev dumi build",
        "docs:build-prd": "del-cli ./docs-dist && cross-env APP_ENV=prd dumi build",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "npm run lint:script && npm run lint:style",
        "lint:script": "eslint \"{src,test}/**/*.{js,jsx,ts,tsx}\"",
        "lint:style": "stylelint \"{src,test}/**/*.{css,less}\"",
        "prepare": "dumi setup"
    },
    "dependencies": {
        "@ant-design/compatible": "^5.1.4",
        "@ant-design/pro-components": "^2.8.9",
        "@babel/runtime": "^7.27.6",
        "@emotion/css": "^11.13.5",
        "@rc-component/trigger": "^3.4.1",
        "@yookue/react-condition": "^0.2.1",
        "@yookue/ts-lang-utils": "^0.2.7",
        "@yookue/ts-multi-map": "^0.2.1",
        "antd-img-crop": "^4.25.0",
        "antd-style": "^3.7.1",
        "cron-validate": "^1.5.2",
        "object-hash": "^3.0.0",
        "rc-scrollbars": "^1.1.6",
        "rc-tween-one": "^3.0.6",
        "react": "~18.2.0",
        "react-color": "^2.19.3",
        "react-dom": "~18.2.0",
        "react-draggable": "^4.5.0",
        "screenfull": "^6.0.2",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@eslint/eslintrc": "^3.3.1",
        "@eslint/js": "^9.30.1",
        "@types/object-hash": "^3.0.6",
        "@types/react": "~18.2.0",
        "@types/react-color": "^3.0.13",
        "@types/react-dom": "~18.2.0",
        "@types/zxcvbn": "^4.4.5",
        "@typescript-eslint/eslint-plugin": "^8.35.1",
        "@yookue/babel-plugin-remove-comment": "^0.2.0",
        "cross-env": "^7.0.3",
        "del-cli": "^6.0.0",
        "dumi": "^2.4.21",
        "dumi-theme-antd": "^0.4.4",
        "father": "^4.5.6",
        "gh-pages": "^6.3.0",
        "globals": "^16.3.0",
        "less": "^4.3.0",
        "less-plugin-no-comment": "^0.1.0",
        "stylelint-config-standard-less": "^3.0.1",
        "typescript": "^5.8.3"
    },
    "peerDependencies": {
        "antd": ">=5"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/yookue/ant-buddy-pro.git"
    },
    "bugs": {
        "url": "https://github.com/yookue/ant-buddy-pro/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/yookue-awesome"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/yookue-awesome"
        },
        {
            "type": "individual",
            "url": "https://yookue.com/donation"
        }
    ],
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "author": {
        "name": "Yookue Ltd",
        "email": "yookue@outlook.com",
        "url": "https://yookue.com"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ]
}
