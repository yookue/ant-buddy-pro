{
    "name": "@unikue/ant-buddy-pro",
    "version": "2.1.13",
    "title": "Ant Buddy Pro",
    "description": "Awesome components based on Ant Design & Ant ProComponents",
    "homepage": "https://unikueltd.github.io/ant-buddy-pro",
    "organization": "Unikue Ltd",
    "private": false,
    "license": "MIT",
    "keywords": [
        "ant-buddy",
        "ant-buddy-pro",
        "antd",
        "ant-design",
        "ant-design-pro",
        "ant-pro-components",
        "admin",
        "dashboard"
    ],
    "files": [
        "dist"
    ],
    "main": "dist/cjs/index.js",
    "module": "dist/esm/index.js",
    "types": "dist/esm/index.d.ts",
    "sideEffects": [
        "**/*.less",
        "**/*.css"
    ],
    "scripts": {
        "start": "npm run start:dev",
        "start:dev": "cross-env APP_ENV=dev dumi dev",
        "start:prd": "cross-env APP_ENV=prd dumi dev",
        "build": "del-cli ./dist && father build",
        "doctor": "father doctor",
        "docs:build": "npm run docs:build-prd",
        "docs:build-dev": "del-cli ./docs-dist && cross-env APP_ENV=dev dumi build",
        "docs:build-prd": "del-cli ./docs-dist && cross-env APP_ENV=prd dumi build",
        "docs:publish": "gh-pages -d ./docs-dist",
        "lint": "npm run lint:script && npm run lint:style",
        "lint:fix": "npm run lint:script:fix && npm run lint:style:fix",
        "lint:script": "eslint \"{src,docs}/**/*.{js,jsx,ts,tsx}\"",
        "lint:script:fix": "eslint --fix \"{src,docs}/**/*.{js,jsx,ts,tsx}\"",
        "lint:style": "stylelint \"{src,docs}/**/*.{css,less}\"",
        "lint:style:fix": "stylelint --fix \"{src,docs}/**/*.{css,less}\"",
        "prepare": "dumi setup",
        "upgrade": "npx npm-check-updates --target semver -u"
    },
    "dependencies": {
        "@ant-design/pro-components": "^3.1.12-0",
        "@unikue/react-condition": "^2.0.1",
        "@unikue/ts-lang-utils": "^1.2.5",
        "@unikue/ts-multi-map": "^1.1.2",
        "ahooks": "^3.9.7",
        "antd-img-crop": "^4.30.0",
        "antd-style": "^4.1.0",
        "cron-validate": "^1.5.3",
        "mathlive": "^0.109.2",
        "object-hash": "^3.0.0",
        "react-custom-scrollbars-4": "^4.5.1",
        "zxcvbn": "^4.4.2"
    },
    "devDependencies": {
        "@byte.n/dumi-theme-antd": "^0.0.2",
        "@eslint/eslintrc": "^3.3.5",
        "@eslint/js": "^10.0.1",
        "@types/object-hash": "^3.0.6",
        "@types/react": "^19.2.17",
        "@types/react-dom": "^19.2.3",
        "@types/zxcvbn": "^4.4.5",
        "@unikue/babel-plugin-remove-comment": "^1.2.1",
        "cross-env": "^10.1.0",
        "del-cli": "^7.0.0",
        "dumi": "^2.4.35",
        "eslint": "^10.5.0",
        "eslint-plugin-jest": "^29.15.2",
        "father": "^4.6.23",
        "gh-pages": "^6.3.0",
        "globals": "^17.7.0",
        "less": "^4.6.7",
        "less-plugin-no-comment": "^0.1.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7",
        "stylelint-config-standard-less": "^4.1.0",
        "typescript": "^6.0.3",
        "typescript-eslint": "^8.62.0"
    },
    "overrides": {
        "antd": "^6.3.7",
        "less-loader": "^12.0.0",
        "react": "^19.2.7",
        "react-dom": "^19.2.7"
    },
    "peerDependencies": {
        "typescript": ">=4.0.0"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/unikueltd/ant-buddy-pro.git"
    },
    "bugs": {
        "url": "https://github.com/unikueltd/ant-buddy-pro/issues"
    },
    "publishConfig": {
        "access": "public",
        "registry": "https://registry.npmjs.org"
    },
    "collective": {
        "url": "https://opencollective.com/unikue-awesome"
    },
    "funding": [
        {
            "type": "opencollective",
            "url": "https://opencollective.com/unikue-awesome"
        },
        {
            "type": "individual",
            "url": "https://unikue.cn/donation"
        }
    ],
    "browserslist": {
        "production": [
            ">0.2%",
            "not dead",
            "not op_mini all"
        ],
        "development": [
            "last 1 chrome version",
            "last 1 firefox version",
            "last 1 safari version"
        ]
    },
    "author": {
        "name": "Unikue Ltd",
        "email": "unikue@yeah.net",
        "url": "https://unikue.cn"
    },
    "contributors": [
        {
            "name": "David Hsing",
            "email": "davidhsing@163.com",
            "url": "https://github.com/davidhsing"
        }
    ]
}
