{
    "compilerOptions": {
        "rootDir": ".",
        "baseUrl": ".",
        "outDir": "./dist",
        "target": "es2020",
        "lib": ["dom", "es2022"],
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "bundler",
        "noImplicitAny": false,
        "noUnusedLocals": true,
        "removeComments": true,
        "skipLibCheck": true,
        "strict": true,
        "types": ["node"],
        "paths": {
            "#/*": [
                "./*"
            ],
            "@/*": [
                "./src/*"
            ],
            "@@/*": [
                ".dumi/tmp/*"
            ],
            "@unikue/ant-buddy-pro": [
                "./src",
            ],
            "@unikue/ant-buddy-pro/*": [
                "./src/*",
            ]
        }
    },
    "include": [
        "src",
        "docs",
        ".dumi",
        ".dumirc.ts",
        ".dumitheme.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "docs-dist"
    ]
}
