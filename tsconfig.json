{
    "compilerOptions": {
        "baseUrl": "./",
        "declaration": true,
        "esModuleInterop": true,
        "jsx": "react-jsx",
        "module": "esnext",
        "moduleResolution": "node",
        "target": "es2015",
        "lib": ["dom", "es2017"],
        "removeComments": true,
        "resolveJsonModule": true,
        "skipLibCheck": true,
        "strict": true,
        "paths": {
            "#/*": [
                "./*"
            ],
            "@/*": [
                "./src/*"
            ],
            "@@/*": [
                ".dumi/tmp/*"
            ],
            "@unikue/ant-buddy-pro": [
                "./src",
            ],
            "@unikue/ant-buddy-pro/*": [
                "./src/*",
            ]
        }
    },
    "include": [
        "src",
        ".dumi",
        ".dumirc.ts",
        ".dumitheme.ts"
    ],
    "exclude": [
        "node_modules",
        "dist",
        "docs-dist"
    ]
}
